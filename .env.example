# Run from the repository root. Never commit .env.
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_PUBLISH_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=GoCommerce
DB_SSLMODE=disable
API_KEY=
JWT_SECRET=
RATE_LIMITER_REQUEST_SEC=5
RATE_LIMITER_REQUEST_BURST=10
SHUTDOWN_TIMEOUT=10s
# Empty for direct local access. Set only the actual reverse proxy IP/CIDR on VPS.
TRUSTED_PROXIES=
